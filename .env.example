# Copy to .env and fill in real values. Never commit the real .env file.
NVD_API_KEY=
GITHUB_TOKEN=

# Optional: signs the dashboard's login session cookies. If left blank, one
# is generated automatically on first run and stored in cache/.secret_key.
# Set this explicitly if you want sessions to survive moving/reinstalling
# the app, or across multiple instances sharing one database.
SECRET_KEY=
