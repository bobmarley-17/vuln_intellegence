# Copy to .env and fill in real values. Never commit the real .env file.
NVD_API_KEY=
GITHUB_TOKEN=

# Optional: signs the dashboard's login session cookies. If left blank, one
# is generated automatically on first run and stored in cache/.secret_key.
# Set this explicitly if you want sessions to survive moving/reinstalling
# the app, or across multiple instances sharing one database.
SECRET_KEY=

# Optional: enables the Action1 integration (Asset Exposure page). Leave
# blank to disable it entirely. Generate API credentials in the Action1
# console under Settings > API/Integrations.
ACTION1_CLIENT_ID=
ACTION1_CLIENT_SECRET=
ACTION1_ORG_ID=

# Optional: enables the Request Tracker integration (auto-ticketing for
# critical/KEV CVEs, related-tickets on CVE detail, ticket creation from
# Asset Exposure). Leave blank to disable it entirely. Points at your RT
# instance's REST 1.0 API (e.g. https://rt.yourcompany.com).
RT_URL=
RT_USERNAME=
RT_PASSWORD=

# NVD CVE discovery -- these are seed-time defaults for the one-time
# "NVD CVE Discovery" system source created on first run. After that, its
# enabled/interval are controlled from the Sources page like any other
# source, not from these env vars.
NVD_DISCOVERY_ENABLED=true
NVD_DISCOVERY_INTERVAL_HOURS=2
NVD_DISCOVERY_LOOKBACK_HOURS=24
